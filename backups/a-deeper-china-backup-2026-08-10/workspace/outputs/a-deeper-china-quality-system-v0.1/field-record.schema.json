{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://adeeperchina.example/schemas/field-record-v0.1.json",
  "title":"A Deeper China Field Record V0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","record_id","city","recorded_at","reviewer_role","record_type","subject","evidence","findings","risk_level","status","next_review_due"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "record_id":{"type":"string","pattern":"^FR-[A-Z]{2,8}-[0-9]{8}-[0-9]{2,4}$"},
    "city":{"type":"string","minLength":2,"maxLength":100},
    "recorded_at":{"type":"string","format":"date-time"},
    "reviewer_role":{"enum":["founder","city_reviewer","content_researcher"]},
    "record_type":{"enum":["route_walk","arrival","venue_access","weather_fallback","community_etiquette","provider_audit","accommodation_practicality","purchase_boundary","other"]},
    "subject":{"type":"object","additionalProperties":false,"required":["id","name"],"properties":{"id":{"type":"string","maxLength":120},"name":{"type":"string","maxLength":200},"related_module_ids":{"type":"array","items":{"type":"string"},"maxItems":12}}},
    "evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["type","captured_at","summary"],"properties":{"type":{"enum":["field_observation","official","venue_direct","provider_document","photo_with_permission","customer_feedback","other"]},"captured_at":{"type":"string","format":"date-time"},"reference":{"type":"string","maxLength":500},"summary":{"type":"string","maxLength":800}}}},
    "findings":{"type":"object","additionalProperties":false,"required":["what_changed","traveller_impact","output_rule"],"properties":{"what_changed":{"type":"string","maxLength":1200},"traveller_impact":{"type":"string","maxLength":1200},"output_rule":{"type":"string","maxLength":1200},"accessible_notes":{"type":"string","maxLength":600},"consent_notes":{"type":"string","maxLength":600}}},
    "risk_level":{"enum":["P0","P1","P2","P3"]},
    "status":{"enum":["active","needs_recheck","suspended","superseded"]},
    "next_review_due":{"type":"string","format":"date-time"},
    "reviewed_by":{"type":"string","maxLength":100}
  }
}
