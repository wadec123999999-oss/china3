{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shanghai Field Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "field_date", "tester", "object", "result", "safety_blocking", "evidence"],
  "properties": {
    "run_id": {"type":"string", "pattern":"^SHRUN[0-9]{3}$"},
    "field_date": {"type":"string", "format":"date"},
    "tester": {"type":"string", "minLength":1},
    "object": {"type":"string", "minLength":1},
    "weather_crowd": {"type":["string","null"]},
    "actual_minutes": {"type":["string","number","null"]},
    "route_entry_exit": {"type":["string","null"]},
    "toilet_seating_water": {"type":["string","null"]},
    "english_access": {"type":["string","null"]},
    "rain_heat_fallback": {"type":["string","null"]},
    "resident_privacy": {"type":["string","null"]},
    "supplier_gate_results": {"type":["object","null"]},
    "safety_blocking": {"type":"boolean"},
    "result": {"enum":["pass","conditional_pass","fail","incomplete"]},
    "conditions": {"type":["string","null"]},
    "issues_changes": {"type":["string","null"]},
    "evidence": {"type":"array", "minItems":2, "items":{"type":"object", "additionalProperties":false, "required":["type","reference","description"], "properties":{"type":{"enum":["track","photo","video","screenshot","written_reply","map_card","interview_note","test_lesson"]},"reference":{"type":"string","minLength":1},"description":{"type":"string","minLength":1}}}}
  }
}
