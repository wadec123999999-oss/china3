{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://adeeperchina.example/schemas/human-check-v0.1.json",
  "title":"A Deeper China Human Check V0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","check_id","case_id","roadbook_id","checked_at","reviewer_role","items","overall_status","unresolved_risks"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "check_id":{"type":"string","pattern":"^HC-[0-9]{8}-[0-9]{2,4}$"},
    "case_id":{"type":"string"},
    "roadbook_id":{"type":"string"},
    "checked_at":{"type":"string","format":"date-time"},
    "reviewer_role":{"enum":["founder","city_reviewer","operations_reviewer"]},
    "items":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["category","status","checked_at","source_type","decision"],"properties":{"category":{"enum":["opening_access","weather_risk","transport","route_pace","accessibility","payment_language","provider","community_etiquette","other"]},"status":{"enum":["verified","changed","not_verified","blocked"]},"checked_at":{"type":"string","format":"date-time"},"source_type":{"enum":["official","venue_direct","field_note","customer_confirmed","provider_document","other"]},"source_reference":{"type":"string","maxLength":500},"decision":{"type":"string","maxLength":500}}}},
    "overall_status":{"enum":["approved_for_publish","approved_with_client_actions","research_only","blocked"]},
    "unresolved_risks":{"type":"array","items":{"type":"string","maxLength":300},"maxItems":16},
    "valid_until":{"type":"string","format":"date-time"}
  }
}
