{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adeeperchina.example/schemas/chongqing-decision-response-v0.1.json",
  "title": "Chongqing Decision Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "databaseVersion", "locale", "status", "followUps", "days", "commercial", "audit"],
  "properties": {
    "requestId": { "type": "string" },
    "databaseVersion": { "type": "string" },
    "locale": { "enum": ["en", "zh-CN"] },
    "status": { "enum": ["needs_confirmation", "roadbook_draft_ready"] },
    "followUps": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["code", "priority", "question"],
        "properties": {
          "code": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
          "question": { "type": "string" }
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "theme", "modules"],
        "properties": {
          "day": { "type": "integer" },
          "theme": { "type": "string" },
          "modules": { "type": "array" }
        }
      }
    },
    "commercial": {
      "type": "object",
      "required": ["state", "mayQuote", "mayTakePayment", "mayPromiseAvailability", "action", "reason", "digitalRoadbook"],
      "properties": {
        "state": { "type": "string" },
        "mayQuote": { "type": "boolean" },
        "mayTakePayment": { "type": "boolean" },
        "mayPromiseAvailability": { "type": "boolean" },
        "action": { "type": "string" },
        "reason": { "type": "string" },
        "digitalRoadbook": {
          "type": "object",
          "required": ["state", "mayOffer", "mayTakePayment", "mayDeliver", "requiresHumanReview", "action", "reason", "boundary"],
          "properties": {
            "state": { "enum": ["eligible_for_manual_review", "intake_incomplete"] },
            "mayOffer": { "type": "boolean" },
            "mayTakePayment": { "type": "boolean" },
            "mayDeliver": { "type": "boolean" },
            "requiresHumanReview": { "const": true },
            "action": { "type": "string" },
            "reason": { "type": "string" },
            "boundary": { "type": "string" }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "required": [
        "usedIntentDimensions",
        "ignoredLowConfidenceDimensions",
        "dynamicChecks",
        "excludedModules",
        "rankedModuleIds",
        "selectedModuleIds",
        "dayAssignment",
        "rule"
      ],
      "properties": {
        "usedIntentDimensions": { "type": "array", "items": { "type": "string" } },
        "ignoredLowConfidenceDimensions": { "type": "array", "items": { "type": "string" } },
        "dynamicChecks": { "type": "array", "items": { "type": "string" } },
        "excludedModules": { "type": "array", "items": { "type": "object" } },
        "rankedModuleIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^RM[0-9]{2}$" }
        },
        "selectedModuleIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^RM[0-9]{2}$" }
        },
        "dayAssignment": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["day", "moduleIds"],
            "properties": {
              "day": { "type": "integer", "minimum": 1, "maximum": 4 },
              "moduleIds": {
                "type": "array",
                "items": { "type": "string", "pattern": "^RM[0-9]{2}$" }
              }
            }
          }
        },
        "rule": { "type": "string" }
      }
    }
  }
}
