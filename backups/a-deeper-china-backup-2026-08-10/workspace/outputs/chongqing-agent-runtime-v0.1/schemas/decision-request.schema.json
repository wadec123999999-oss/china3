{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adeeperchina.example/schemas/chongqing-decision-request-v0.1.json",
  "title": "Chongqing Decision Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "stage", "trip", "intents", "constraints", "purchase"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "locale": { "enum": ["en", "zh-CN"], "default": "en" },
    "stage": {
      "enum": ["灵感", "路线规划", "询价", "行中改线", "供应商运营"]
    },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "profile", "fitness", "weather", "outputLength", "arrivalDepartureKnown", "hotelAreaKnown"],
      "properties": {
        "days": { "type": "integer", "minimum": 1, "maximum": 4 },
        "profile": {
          "enum": ["首次经典", "赛博摄影", "文化历史", "美食生活", "亲子轻松", "复游客"]
        },
        "fitness": { "enum": ["低", "中", "高", "未知"] },
        "weather": { "enum": ["正常", "雨天", "炎热", "暴雨", "极端高温", "低能见度"] },
        "outputLength": { "enum": ["精简", "标准", "深度"] },
        "arrivalDepartureKnown": { "type": "boolean" },
        "hotelAreaKnown": { "type": "boolean" }
      }
    },
    "intents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intensity", "confidence", "evidenceQuote"],
        "properties": {
          "intensity": { "type": "number", "minimum": 0, "maximum": 5 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidenceQuote": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "liveChecks": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "requestedModuleIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^RM[0-9]{2}$" },
      "uniqueItems": true
    },
    "excludedModuleIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^RM[0-9]{2}$" },
      "uniqueItems": true
    },
    "purchase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asksPrice", "asksBooking", "asksPayment", "asksCancellation"],
      "properties": {
        "experienceId": { "type": ["string", "null"] },
        "asksPrice": { "type": "boolean" },
        "asksBooking": { "type": "boolean" },
        "asksPayment": { "type": "boolean" },
        "asksCancellation": { "type": "boolean" }
      }
    }
  }
}
