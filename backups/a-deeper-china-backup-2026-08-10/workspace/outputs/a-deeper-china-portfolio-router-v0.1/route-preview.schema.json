{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A Deeper China Free Route Preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["valid", "schema_version", "status", "product_id", "city", "route_thesis", "candidate_modules", "commercial", "delivery_boundary"],
  "properties": {
    "valid": {"const": true},
    "schema_version": {"const": "1.0"},
    "status": {"const": "preview_only"},
    "product_id": {"const": "route_preview"},
    "city": {"type": "string", "minLength": 1},
    "route_thesis": {"type": "string", "minLength": 1},
    "what_we_heard": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "what_we_are_protecting": {"type": ["string", "null"]},
    "candidate_modules": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
    "why_this_route_fits": {"type": "array", "maxItems": 2, "items": {"type": "string"}},
    "hypotheses_to_confirm": {"type": "array", "maxItems": 2, "items": {"type": "string"}},
    "deliberately_not_included": {"type": "array", "items": {"type": "string"}},
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payment_allowed", "quote_allowed", "product_name", "upgrade_product_id", "upgrade_reason"],
      "properties": {
        "payment_allowed": {"const": false},
        "quote_allowed": {"const": false},
        "product_name": {"const": "Free Route Preview"},
        "upgrade_product_id": {"const": "deep_roadbook"},
        "upgrade_reason": {"type": "string", "minLength": 1}
      }
    },
    "delivery_boundary": {"type": "string", "minLength": 1}
  }
}
